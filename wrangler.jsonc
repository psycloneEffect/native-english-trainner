{
  // 公開URLになる名前。workers.dev のサブドメインがそのままこの値になる。
  // 変更すると別のWorkerが新規作成され、Secretも引き継がれない。
  "name": "native-english-trainner",
  "main": "worker/index.js",
  "compatibility_date": "2025-02-01",
  "assets": {
    // public/ をそのまま配信する。ビルド不要。
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // === 実行回数の上限（未設定） ===
  // ダッシュボード → Storage & Databases → KV → Create a namespace で作成し、
  // 表示される Namespace ID を下に貼ってコメントを外す。IDは秘密情報ではない。
  // 有効にするまで、生成は quota_not_configured で停止する（上限なしで動くことを避けるため）。
  //
  "kv_namespaces": [
     { "binding": "QUOTA", "id": ""kv_namespaces": [{
                    "binding": "KV_BINDING",
                    "id": "c984207846054c8c9dab0723346ad3e1"
                 }]" }
  ],

  "vars": {
    "MODEL": "claude-sonnet-5",
    // 1日あたりの実行回数。全体と、端末ごと。KVを有効にしてから効く。
    "DAILY_LIMIT": "30",
    "PER_CLIENT_LIMIT": "10"
  }

  // 以下はダッシュボードの Settings > Variables and Secrets で Secret として登録する。
  // このファイルには絶対に書かない（リポジトリに平文で残るため）。
  //   ANTHROPIC_API_KEY  Claude Console の APIキー
  //   APP_USERNAME       ログインID
  //   APP_PASSWORD       ログインパスワード
  //   SESSION_SECRET     セッション署名用のランダム文字列（32文字以上）
}
