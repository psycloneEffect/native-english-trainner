{
  // 公開URLになる名前。workers.dev のサブドメインがそのままこの値になる。
  // 変更すると別のWorkerが新規作成され、Secretも引き継がれない。
  "name": "native-english-trainner",
  "main": "worker/index.js",
  "compatibility_date": "2025-02-01",
  "assets": {
    // public/ をそのまま配信する。ビルド不要。
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  // === 実行回数の上限 ===
  // binding は必ず QUOTA にする。worker/quota.js が env.QUOTA を読むため、
  // ダッシュボードが例示する KV_BINDING のままだと quota_not_configured になる。
  // id は KV Namespace の ID（秘密情報ではない）。
  "kv_namespaces": [
    { "binding": "QUOTA", "id": "c984207846054c8c9dab0723346ad3e1" }
  ],

  "vars": {
    "MODEL": "claude-sonnet-5",
    // 1日あたりの実行回数。全体と、端末ごと。KVを有効にしてから効く。
    "DAILY_LIMIT": "30",
    "PER_CLIENT_LIMIT": "10"
    // 管理者の1日あたり上限。未設定なら管理者は無制限。
    // 管理者を有効にするには ADMIN_USERNAME / ADMIN_PASSWORD を Secret に登録する。
    // , "ADMIN_DAILY_LIMIT": "100"
  }

  // 以下はダッシュボードの Settings > Variables and Secrets で Secret として登録する。
  // このファイルには絶対に書かない（リポジトリに平文で残るため）。
  //   ANTHROPIC_API_KEY  Claude Console の APIキー
  //   APP_USERNAME       ログインID
  //   APP_PASSWORD       ログインパスワード
  //   SESSION_SECRET     セッション署名用のランダム文字列（32文字以上）
  //   ADMIN_USERNAME     （任意）管理者のログインID
  //   ADMIN_PASSWORD     （任意）管理者のパスワード。共有パスワードとは別の強い値にする
}
